struct student {
   let name = ""
	let age = 0
	let marks = []
}

struct mark {
  let subject = ""
  let marks = 0
}

let students = [] # to store all students 

fun createStudent(){
   let s1=new student
	s1["name"]=getInput("enter the name of the student :")
	s1["age"]=toInt(getInput("enter the age of the student : "))
	let n = toInt(getInput("enter the number of subjects : "))
	for( sc in 0->n){
      let sub =  new mark
		sub["subject"]=getInput("enter the name of the subject")
		sub["marks"]= getInput("enter the marks in the subject")
		let marksArray=s1["marks"]
		marksArray <~ sub
	}
	students <~ s1
}

let n = toInt(getInput("enter the number of students : "))
for( i in 0 -> n ){
  createStudent()
}
printOut(students)

