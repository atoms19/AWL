include "stdlib/complex.awl"


fun mandelbrot(c) {
    let limit = 100 
    let z = complex(0,0)
    for (i in 0 -> limit) {
        if (complexMagSqr(z) > 4) {
		      limit = i
            break
        }
		  z=complexAdd(complexMul(z,z),c)  # z =  z^2 + c  (someday we will support complex ops)
    }
    return limit
}


# canvas size
let width = 150
let height = 50

# our window 
let xstart = -2.25 
let xend = 0.25   
let ystart = -1 
let yend = 1    
let dx = (xend - xstart) / (width - 1)
let dy = (yend - ystart) / (height - 1)


for (y in ystart -> yend by dy) {
    let line = "||" 
    for (x in xstart -> xend  by dx) {
        let value = mandelbrot(complex(x,y))
        if (value == 100) {
            line = line + " " # In the set
        } else if (value > 50) {
            line = line + "-"
        } else if (value > 25) {
            line = line + "+"
        } else if (value > 10) {
            line = line + "o"
        } else if (value > 5) {
            line = line + "0"
        } else {
            line = line + "#" # Escaped very quickly
        }
    }

    line = line + "||"
    printOut(line)
}

